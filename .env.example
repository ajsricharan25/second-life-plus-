# Server-side only. Never use a VITE_ prefix for this secret.
REPAIR_AI_API_KEY=
# Optional: openai, gemini, or groq. With no selection, prefer OpenAI, then
# Gemini, then Groq when its key is set. No automatic cross-provider retries.
REPAIR_AI_PROVIDER=
# OpenAI model must support images and JSON output through Responses.
REPAIR_AI_MODEL=gpt-4.1
# Alternative: Google Gemini with images and JSON output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Groq: one AI call per assessment/action. Tavily supplies web evidence.
# Set REPAIR_AI_PROVIDER=groq explicitly when keeping another provider's key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Web evidence for prices, recycling and local shops. Basic searches only.
# Initial report: up to 3 searches. Follow-up action: up to 1 search.
# With no key, only clearly labelled model guidance is available.
# Check your account's free allowance and eligibility before configuring.
TAVILY_API_KEY=

# Optional persistent daily allowance. Enable only after setting up Auth0 + Redis.
# All values here stay server-side; /api/access exposes only public Auth0 settings.
DAILY_QUOTA_ENABLED=false
DAILY_AI_LIMIT=3
# Keep this stable across redeployments; use different namespaces for separate apps.
DAILY_QUOTA_NAMESPACE=second-life-plus
# Auth0 Single Page Application + a custom API using RS256.
# Domain and client ID are public identifiers, NOT an Auth0 client secret.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://second-life-api
# Upstash Redis REST URL + read/write token. Use an eligible free-plan database.
# Never put the Redis token in browser code or give it a VITE_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
