# Server-side only. Never use a VITE_ prefix for this secret.
REPAIR_AI_API_KEY=
# Optional: openai, gemini, or groq. With no selection, prefer OpenAI, then
# Gemini, then Groq when its key is set. No automatic cross-provider retries.
REPAIR_AI_PROVIDER=
# OpenAI model must support images, Responses web_search, and structured output.
REPAIR_AI_MODEL=gpt-4.1
# Alternative: configure Google Gemini with Google Search grounding.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Groq: one bounded AI call; optional Tavily search enables cited price checks.
# Set REPAIR_AI_PROVIDER=groq explicitly when keeping another provider's key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional. Search uses the basic endpoint; no automatic paid upgrades.
# Check your account's free allowance and eligibility before configuring.
TAVILY_API_KEY=
